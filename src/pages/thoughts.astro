---
import { getCollection, render } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Page from "../layouts/Page.astro";

const thoughts = (await getCollection("thoughts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const BATCH = 6;

const renderedPosts = await Promise.all(
    thoughts.map(async (post) => {
        const { Content } = await render(post);
        return { id: post.id, data: post.data, Content };
    }),
);
---

<Page
    title="碎碎念 — ThriceCola's Blog"
    description="三瓶可乐不过岗的日常与碎碎念"
    mainClass="layout-wide"
>
        <style>
            #thoughts-feed {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.5em;
                align-items: start;
            }

            .thought-card {
                padding: 24px 28px;
            }

            .thought-date {
                font-size: 0.82em;
                color: var(--semi-accent-color);
                margin: 0 0 1.2em;
                padding-bottom: 0.85em;
                border-bottom: 1px dashed var(--semi-accent-color);
            }

            .thought-body {
                font-size: 0.95em;
                line-height: 1.7;
                color: var(--normal-text-color);
                overflow-wrap: break-word;
            }
            .thought-body p {
                margin: 0 0 0.6em;
            }
            .thought-body p:last-child {
                margin-bottom: 0;
            }
            .thought-body img {
                max-width: 100%;
                height: auto;
                margin: 0.5em 0;
            }
            .thought-body a {
                color: var(--accent-color);
            }
            .thought-body blockquote {
                margin: 0.5em 0;
                padding: 0.5em 1em;
                border-left: 3px solid var(--shadow-color);
                color: var(--semi-accent-color);
            }
            .thought-body code {
                font-size: 0.9em;
                padding: 0.15em 0.4em;
                background: color-mix(
                    in srgb,
                    var(--semi-accent-color) 12%,
                    transparent
                );
            }
            .thought-body pre {
                padding: 1em;
                overflow-x: auto;
                border: 1px solid var(--semi-accent-color);
                background: color-mix(
                    in srgb,
                    var(--semi-accent-color) 6%,
                    transparent
                );
            }
            .thought-body pre code {
                background: none;
                padding: 0;
            }
            .thought-body ul,
            .thought-body ol {
                padding-left: 1.5em;
                margin: 0 0 0.8em;
            }
            .thought-body li {
                margin-bottom: 0.25em;
            }
            .thought-body li:last-child {
                margin-bottom: 0;
            }
            .thought-body hr {
                border: none;
                border-top: 1px dashed var(--semi-accent-color);
                margin: 0.8em 0;
            }

            @media (max-width: 720px) {
                #thoughts-feed {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 480px) {
                .thought-card {
                    padding: 16px 14px;
                }
                .thought-body {
                    font-size: 0.9em;
                }
                .thought-date {
                    margin-bottom: 0.75em;
                    padding-bottom: 0.5em;
                }
            }

        </style>
            <div class="page-header">
                <h1>碎碎念</h1>
                <p>日常、想法、碎片记录</p>
            </div>

            <section id="thoughts-feed">
                {
                    renderedPosts.map((post, i) => (
                        <article
                            class:list={[
                                "thought-card",
                                "card",
                                "card--hover",
                                i >= BATCH && "hidden-post",
                            ]}
                        >
                            <p class="thought-date">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                            <div class="thought-body">
                                <post.Content />
                            </div>
                        </article>
                    ))
                }
            </section>

            <div id="sentinel" class="feed-sentinel"></div>
            {
                renderedPosts.length > BATCH && (
                    <p id="feed-end" class="feed-end" hidden>
                        — 已经到底啦 —
                    </p>
                )
            }
</Page>
<script>
    import { initContentImages, onceOnPageLoad } from "../scripts/images";
    import { revealFeed } from "../scripts/reveal-feed";

    function initThoughtFeed() {
        initContentImages(".thought-body img");
        const feed = document.getElementById("thoughts-feed");
        const sentinel = document.getElementById("sentinel");
        const feedEnd = document.getElementById("feed-end");
        if (!feed || !sentinel) return;
        revealFeed({
            feed,
            sentinel,
            end: feedEnd,
            cardSelector: ".thought-card.hidden-post",
            onReveal: (card) => initContentImages(".thought-body img", card),
        });
    }

    onceOnPageLoad("thoughts-feed", initThoughtFeed);
</script>
