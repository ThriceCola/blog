---
import { getCollection, render } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import LoadingBar from "../components/LoadingBar.astro";
import { ClientRouter } from "astro:transitions";

const thoughts = (await getCollection("thoughts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const BATCH = 6;

const renderedPosts = await Promise.all(
    thoughts.map(async (post) => {
        const { Content } = await render(post);
        return { id: post.id, data: post.data, Content };
    }),
);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead
            title="碎碎念 — ThriceCola's Blog"
            description="ThriceCola 的日常与碎碎念"
        />
        <ClientRouter />
        <LoadingBar />
        <style>
            main {
                max-width: 960px;
                margin: 0 auto;
            }

            #thoughts-feed {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.5em;
                align-items: start;
            }

            .thought-card {
                border: 1px solid var(--semi-accent-color);
                box-shadow: -6px 8px 2px 1px var(--shadow-color);
                background-color: var(--background-color);
                padding: 24px 28px;
                margin: 0;
                transition: box-shadow 0.2s;
            }
            .thought-card:hover {
                box-shadow: -8px 10px 2px 1px var(--shadow-color);
            }

            .thought-date {
                font-size: 0.82em;
                color: var(--semi-accent-color);
                margin: 0 0 1.2em;
                padding-bottom: 0.85em;
                border-bottom: 1px dashed var(--semi-accent-color);
            }

            .thought-body {
                font-size: 0.95em;
                line-height: 1.7;
                color: var(--normal-text-color);
                overflow-wrap: break-word;
            }
            .thought-body p {
                margin: 0 0 0.6em;
            }
            .thought-body p:last-child {
                margin-bottom: 0;
            }
            .thought-body img {
                max-width: 100%;
                height: auto;
                margin: 0.5em 0;
            }
            .thought-body a {
                color: var(--accent-color);
            }
            .thought-body blockquote {
                margin: 0.5em 0;
                padding: 0.5em 1em;
                border-left: 3px solid var(--shadow-color);
                color: var(--semi-accent-color);
            }
            .thought-body code {
                font-size: 0.9em;
                padding: 0.15em 0.4em;
                background: color-mix(
                    in srgb,
                    var(--semi-accent-color) 12%,
                    transparent
                );
            }
            .thought-body pre {
                padding: 1em;
                overflow-x: auto;
                border: 1px solid var(--semi-accent-color);
                background: color-mix(
                    in srgb,
                    var(--semi-accent-color) 6%,
                    transparent
                );
            }
            .thought-body pre code {
                background: none;
                padding: 0;
            }
            .thought-body ul,
            .thought-body ol {
                padding-left: 1.5em;
                margin: 0 0 0.8em;
            }
            .thought-body li {
                margin-bottom: 0.25em;
            }
            .thought-body li:last-child {
                margin-bottom: 0;
            }
            .thought-body hr {
                border: none;
                border-top: 1px dashed var(--semi-accent-color);
                margin: 0.8em 0;
            }

            @media (max-width: 720px) {
                #thoughts-feed {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 480px) {
                .thought-card {
                    padding: 16px 14px;
                }
                .thought-body {
                    font-size: 0.9em;
                }
                .thought-date {
                    margin-bottom: 0.75em;
                    padding-bottom: 0.5em;
                }
            }

            .hidden-post {
                display: none;
            }

            #sentinel {
                height: 1px;
                width: 100%;
            }

            .feed-end {
                text-align: center;
                padding: 1.5em 0;
                color: var(--semi-accent-color);
                font-size: 0.9em;
            }
            .feed-end[hidden] {
                display: none;
            }
        </style>
        <style is:global>
            .thought-body img {
                opacity: 0;
                transition: opacity 0.5s ease-out;
                background: var(--shadow-color);
            }
            .thought-body img.loaded {
                opacity: 1;
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <div class="page-header">
                <h1>碎碎念</h1>
                <p>日常、想法、碎片记录</p>
            </div>

            <section id="thoughts-feed">
                {
                    renderedPosts.map((post, i) => (
                        <article
                            class:list={[
                                "thought-card",
                                i >= BATCH && "hidden-post",
                            ]}
                        >
                            <p class="thought-date">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                            <div class="thought-body">
                                <post.Content />
                            </div>
                        </article>
                    ))
                }
            </section>

            <div id="sentinel"></div>
            {
                renderedPosts.length > BATCH && (
                    <p id="feed-end" class="feed-end" hidden>— 已经到底啦 —</p>
                )
            }
        </main>
        <Footer />

        <script>
            declare global {
                interface Window {
                    __thoughtsInit?: boolean;
                }
            }

            function initThoughtImages(root?: ParentNode) {
                (root || document).querySelectorAll(".thought-body img").forEach((el) => {
                    const img = el as HTMLImageElement;
                    if (img.dataset.progressive) return;
                    img.dataset.progressive = "1";
                    if (img.complete) {
                        img.style.transition = "none";
                        img.classList.add("loaded");
                        img.offsetHeight;
                        img.style.transition = "";
                    } else {
                        img.addEventListener("load", () => img.classList.add("loaded"), {
                            once: true,
                        });
                        img.addEventListener("error", () => img.classList.add("loaded"), {
                            once: true,
                        });
                    }
                });
            }

            function initThoughtFeed() {
                initThoughtImages();

                const BATCH = 6;
                const feed = document.getElementById("thoughts-feed");
                const sentinel = document.getElementById("sentinel");
                const feedEnd = document.getElementById("feed-end");
                if (!feed || !sentinel || feed.dataset.bound) return;
                feed.dataset.bound = "1";

                const cards = feed.querySelectorAll<HTMLElement>(".thought-card.hidden-post");
                let remaining = cards.length;
                let loading = false;

                const observer = new IntersectionObserver(
                    (entries) => {
                        if (!entries[0].isIntersecting || loading || remaining <= 0) return;
                        loading = true;

                        const start = cards.length - remaining;
                        const end = Math.min(start + BATCH, cards.length);
                        for (let i = start; i < end; i++) {
                            cards[i].style.setProperty("--enter-i", String(i - start));
                            cards[i].classList.add("card-enter");
                            cards[i].classList.remove("hidden-post");
                            initThoughtImages(cards[i]);
                        }
                        remaining = cards.length - end;

                        if (remaining <= 0) {
                            observer.unobserve(sentinel);
                            feedEnd?.removeAttribute("hidden");
                        }
                        loading = false;
                    },
                    { rootMargin: "200px" },
                );

                if (cards.length > 0) observer.observe(sentinel);
                else feedEnd?.removeAttribute("hidden");
            }

            initThoughtFeed();
            if (!window.__thoughtsInit) {
                window.__thoughtsInit = true;
                document.addEventListener("astro:page-load", initThoughtFeed);
            }
        </script>
    </body>
</html>
