---
import { Image } from "astro-lqip/components";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Page from "../../layouts/Page.astro";
import { coverImage } from "../../lib/cover-image";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const BATCH = 6;

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="layout-wide">
		<style>
			ul {
				display: flex;
				flex-direction: column;
				gap: 1.75rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				display: flex;
				gap: 1.5rem;
				text-decoration: none;
				padding: 22px 28px;
			}
			.post-body {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-width: 0;
				flex: 1;
			}
			.post-title {
				margin: 0 0 0.35em 0;
				font-size: 1.25em;
				color: var(--normal-text-color);
				line-height: 1.3;
			}
			.post-desc {
				margin: 0 0 0.5em 0;
				color: var(--semi-accent-color);
				font-size: 0.95em;
				line-height: 1.5;
			}
			.post-date {
				margin: 0;
				color: var(--semi-accent-color);
				font-size: 0.85em;
			}
			@media (max-width: 640px) {
				.post-card {
					flex-direction: column;
					gap: 0.75rem;
					padding: 16px 18px;
				}
			}
			@media (max-width: 480px) {
				ul {
					gap: 1.25rem;
				}
				.post-card {
					padding: 14px 14px;
				}
				.post-title {
					font-size: 1.1em;
				}
			}
		</style>
			<div class="page-header">
				<h1>文章</h1>
				<p>长文放置于此</p>
			</div>

			<section>
				<ul id="blog-feed">
					{
						posts.map((post, i) => {
							const { src, position } = coverImage(post.data);
							return (
								<li class:list={[i >= BATCH && "hidden-post"]}>
									<a
										href={`/blog/${post.id}/`}
										class="post-card card card--hover"
									>
										<div class="post-body">
											<h4 class="post-title">{post.data.title}</h4>
											{post.data.description && (
												<p class="post-desc line-clamp-3">
													{post.data.description}
												</p>
											)}
											<p class="post-date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
										{src && (
											<div class="post-image framed-image">
												<Image
													width={240}
													height={140}
													src={src}
													alt=""
													lqip="base64"
													lqipSize={10}
													decoding="sync"
													style={{ objectPosition: position }}
												/>
											</div>
										)}
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>

			<div id="sentinel" class="feed-sentinel"></div>
			{
				posts.length > BATCH && (
					<p id="feed-end" class="feed-end" hidden>— 已经到底啦 —</p>
				)
			}
</Page>
<script>
	import { initLqipImages, onceOnPageLoad } from "../../scripts/images";
	import { revealFeed } from "../../scripts/reveal-feed";

	function initBlogFeed() {
		initLqipImages();
		const feed = document.getElementById("blog-feed");
		const sentinel = document.getElementById("sentinel");
		const feedEnd = document.getElementById("feed-end");
		if (!feed || !sentinel) return;
		revealFeed({
			feed,
			sentinel,
			end: feedEnd,
			cardSelector: "li.hidden-post",
			onReveal: (card) => initLqipImages(card),
		});
	}

	onceOnPageLoad("blog-feed", initBlogFeed);
</script>
