---
import FriendsList from "../components/FriendsList.vue";
import Page from "../layouts/Page.astro";
---

<Page title="友链 — ThriceCola's Blog" description="三瓶可乐不过岗的朋友们">
        <style>
            .friends-guide {
                margin-bottom: 2.5em;
            }

            .friends-guide h2 {
                margin: 0 0 0.5em;
                font-size: 1.1em;
                color: var(--normal-text-color);
            }

            .friends-guide p {
                margin-bottom: 0.8em;
            }

            .friends-guide pre {
                padding: 0.6em 0.8em;
                border-left: 3px solid var(--semi-accent-color);
                background: none;
                font-size: 0.85em;
            }

            @media (max-width: 720px) {
                .friends-guide {
                    margin-bottom: 1.5em;
                }
            }
        </style>
            <div class="page-header">
                <h1>友链</h1>
                <p>一些有意思的朋友和站点</p>
            </div>

            <div class="friends-guide">
                <h2>想交换友链？</h2>
                <p>
                    在<a
                        href="https://github.com/ThriceCola/blog/issues/1"
                        target="_blank"
                        rel="noopener"
                    >
                        GitHub
                    </a>
                    留下评论，按如下格式附上你的信息即可
                </p>
                <pre><code>name = "三瓶可乐不过岗"
url = "https://blog.thricecola.com"
avatar = "https://blog.thricecola.com/img/avatar.jpg"
description = "看看~ 看看~"
rss = "https://blog.thricecola.com/rss.xml"</code></pre>
            </div>

            <FriendsList client:load />
</Page>
