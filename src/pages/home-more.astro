---
import { getCollection } from "astro:content";
import ThoughtChannelCard from "../components/home/ThoughtChannelCard.astro";
import BlogChannelCard from "../components/home/BlogChannelCard.astro";

const moreThoughts = (await getCollection("thoughts"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(1, 3);

const moreBlogs = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(1, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex, nofollow" />
		<title>home-more</title>
	</head>
	<body>
		<div data-more-thoughts>
			{moreThoughts.map((thought) => <ThoughtChannelCard thought={thought} />)}
		</div>
		<div data-more-blogs>
			{moreBlogs.map((blog) => <BlogChannelCard blog={blog} />)}
		</div>
	</body>
</html>
