---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LoadingBar from "../components/LoadingBar.astro";
import HomeChannels from "../components/home/HomeChannels.astro";
import { ClientRouter } from "astro:transitions";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/home.css";

const blogs = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const thoughts = (await getCollection("thoughts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <ClientRouter />
        <LoadingBar />
    </head>
    <body>
        <Header />
        <main class="home-main">
            <div class="home-hero">
                <h1>ThriceCola's Blog</h1>
                <h3>{SITE_DESCRIPTION}</h3>
                <p>你是从哪里找到我的呢?</p>
            </div>
            <HomeChannels
                thought={thoughts[0]}
                blog={blogs[0]}
                hasMore={blogs.length > 1 || thoughts.length > 1}
            />
        </main>
        <Footer />
        <script>
            declare global {
                interface Window {
                    __homeImgInit?: boolean;
                }
            }

            function initHomeImages() {
                document
                    .querySelectorAll("[data-astro-lqip]")
                    .forEach((wrapper) => {
                        const img = wrapper.querySelector("img");
                        if (!img || img.dataset.lqipInit) return;
                        img.dataset.lqipInit = "1";
                        if (img.complete) {
                            wrapper.classList.add("lqip-cached");
                            img.style.transition = "none";
                            img.classList.add("loaded");
                            img.offsetHeight;
                            img.style.transition = "";
                        } else {
                            img.addEventListener(
                                "load",
                                () => img.classList.add("loaded"),
                                {
                                    once: true,
                                },
                            );
                            img.addEventListener(
                                "error",
                                () => img.classList.add("loaded"),
                                {
                                    once: true,
                                },
                            );
                        }
                    });
                document
                    .querySelectorAll(".thought-content img")
                    .forEach((el) => {
                        const img = el as HTMLImageElement;
                        if (img.dataset.progressive) return;
                        img.dataset.progressive = "1";
                        if (img.complete) {
                            img.style.transition = "none";
                            img.classList.add("loaded");
                            img.offsetHeight;
                            img.style.transition = "";
                        } else {
                            img.addEventListener(
                                "load",
                                () => img.classList.add("loaded"),
                                {
                                    once: true,
                                },
                            );
                            img.addEventListener(
                                "error",
                                () => img.classList.add("loaded"),
                                {
                                    once: true,
                                },
                            );
                        }
                    });
            }

            initHomeImages();
            if (!window.__homeImgInit) {
                window.__homeImgInit = true;
                document.addEventListener("astro:page-load", initHomeImages);
                document.addEventListener("home:content", initHomeImages);
            }
        </script>
    </body>
</html>
