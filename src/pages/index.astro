---
import { getCollection } from "astro:content";
import HomeChannels from "../components/home/HomeChannels.astro";
import HomeFeed from "../components/home/HomeFeed.astro";
import Page from "../layouts/Page.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/home.css";

const blogs = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const thoughts = (await getCollection("thoughts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-main layout-wide">
    <div class="home-hero">
        <h1>ThriceCola's Blog</h1>
        <h3>{SITE_DESCRIPTION}</h3>
        <p>你是从哪里找到我的呢?</p>
    </div>
    <HomeChannels
        thought={thoughts[0]}
        blog={blogs[0]}
        hasMore={blogs.length > 1 || thoughts.length > 1}
    />
    <HomeFeed thoughts={thoughts} blogs={blogs} />
</Page>
<script>
    import { initContentImages, initLqipImages, onceOnPageLoad } from "../scripts/images";

    onceOnPageLoad(
        "home-images",
        () => {
            initLqipImages();
            initContentImages(".thought-content img");
        },
        ["home:content"],
    );
</script>
