---
import ThoughtChannelCard from "./ThoughtChannelCard.astro";
import BlogChannelCard from "./BlogChannelCard.astro";
import HomeEntryLinks from "./HomeEntryLinks.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    thought: CollectionEntry<"thoughts"> | undefined;
    blog: CollectionEntry<"blog"> | undefined;
    hasMore: boolean;
}

const { thought, blog, hasMore } = Astro.props;
---

{/* Mobile-only: list-page entries above content */}
<div class="home-entries">
    <HomeEntryLinks />
</div>

<section
    class="home-channels"
    data-home-channels
    data-has-more={hasMore ? "1" : "0"}
>
    <div class="channel-col" data-channel="thoughts">
        <header class="channel-col__head">
            <a href="/thoughts">碎碎念</a>
        </header>
        {thought && <ThoughtChannelCard thought={thought} latest />}
        <div data-channel-more></div>
        <footer class="channel-col__foot">
            <a href="/thoughts">查看更多碎碎念 →</a>
        </footer>
    </div>

    <div class="channel-col" data-channel="blogs">
        <header class="channel-col__head">
            <a href="/blog">文章</a>
        </header>
        {blog && <BlogChannelCard blog={blog} latest />}
        <div data-channel-more></div>
        <footer class="channel-col__foot">
            <a href="/blog">查看更多文章 →</a>
        </footer>
    </div>

    {
        /* Desktop: fills short-column height gap; toggle sits under the nav cards */
    }
    <div class="channel-guides" data-channel-guides hidden>
        <div class="channel-guides__cards">
            <HomeEntryLinks />
        </div>
        {
            hasMore && (
                <div class="channel-guides__action">
                    <button
                        type="button"
                        class="channel-toggle card card--hover"
                        data-channel-expand
                        hidden
                        aria-label="展开更多内容"
                    >
                        展开
                    </button>
                    <button
                        type="button"
                        class="channel-toggle card card--hover"
                        data-channel-collapse
                        hidden
                        aria-label="收起"
                    >
                        收起
                    </button>
                </div>
            )
        }
    </div>
</section>

<script>
    declare global {
        interface Window {
            __homeChannelsInit?: boolean;
        }
    }

    const DESKTOP_MQ = "(min-width: 801px)";
    const MORE_URL = "/home-more/";
    const EXPAND_KEY = "home-channels-expanded";
    const EXIT_MS = 275; // collapse fade duration (cards + height-fill area)
    const GUIDE_DELAY = 100; // height-fill area fades in shortly after the cards

    function isExpandedCached() {
        try {
            return localStorage.getItem(EXPAND_KEY) === "1";
        } catch {
            return false;
        }
    }

    function setExpandedCached(expanded: boolean) {
        try {
            if (expanded) localStorage.setItem(EXPAND_KEY, "1");
            else localStorage.removeItem(EXPAND_KEY);
        } catch {
            /* ignore quota / private mode */
        }
    }

    function fillSlot(
        slot: Element | null,
        source: Element | null,
        animate = true,
    ) {
        if (!slot || !source) return;
        const cards = [...source.children].map(
            (n) => document.importNode(n, true) as HTMLElement,
        );
        cards.forEach((card, i) => {
            if (!animate) return;
            card.style.setProperty("--enter-i", String(i));
            card.classList.add("card-enter");
        });
        slot.replaceChildren(...cards);
    }

    function hideExpands(root: HTMLElement) {
        const expand = root.querySelector<HTMLButtonElement>(
            "[data-channel-expand]",
        );
        if (!expand) return;
        expand.hidden = true;
        expand.disabled = false;
        if (expand.dataset.label) expand.textContent = expand.dataset.label;
    }

    function hideCollapse(root: HTMLElement) {
        const collapse = root.querySelector<HTMLButtonElement>(
            "[data-channel-collapse]",
        );
        if (!collapse) return;
        collapse.hidden = true;
    }

    function syncToggle(root: HTMLElement) {
        const expand = root.querySelector<HTMLButtonElement>(
            "[data-channel-expand]",
        );
        const collapse = root.querySelector<HTMLButtonElement>(
            "[data-channel-collapse]",
        );
        const desktop = window.matchMedia(DESKTOP_MQ).matches;
        const hasMore = root.dataset.hasMore === "1";
        const expanded = root.classList.contains("is-expanded");

        if (expand) {
            expand.hidden = !(desktop && hasMore && !expanded);
            if (!expand.hidden) {
                expand.disabled = false;
                if (expand.dataset.label)
                    expand.textContent = expand.dataset.label;
            }
        }
        if (collapse) {
            collapse.hidden = !(desktop && hasMore && expanded);
            collapse.disabled = root.dataset.loading === "1";
        }
    }

    function parkGuides(root: HTMLElement) {
        const guides = root.querySelector<HTMLElement>("[data-channel-guides]");
        if (!guides) return;
        guides.hidden = true;
        guides.style.height = "";
        guides.style.minHeight = "";
        root.appendChild(guides);
    }

    function hideGuides(root: HTMLElement) {
        const guides = root.querySelector<HTMLElement>("[data-channel-guides]");
        if (!guides) return;
        parkGuides(root);
        hideExpands(root);
        hideCollapse(root);
    }

    function colContentHeight(col: HTMLElement) {
        let top = Infinity;
        let bottom = -Infinity;
        for (const child of col.children) {
            const el = child as HTMLElement;
            if (el.matches("[data-channel-guides], [data-channel-guide]"))
                continue;
            if (el.hidden) continue;
            const style = getComputedStyle(el);
            if (style.display === "none") continue;
            if (el.matches("[data-channel-more]") && !el.childElementCount)
                continue;
            const r = el.getBoundingClientRect();
            if (r.height === 0) continue;
            top = Math.min(top, r.top);
            bottom = Math.max(bottom, r.bottom);
        }
        return Number.isFinite(top) ? bottom - top : 0;
    }

    function shortColOf(root: HTMLElement) {
        const cols = [...root.querySelectorAll<HTMLElement>("[data-channel]")];
        if (cols.length !== 2) return null;
        const [h0, h1] = cols.map(colContentHeight);
        const shortCol = cols[h0 <= h1 ? 0 : 1];
        const gap = parseFloat(getComputedStyle(shortCol).gap) || 0;
        return { shortCol, fill: Math.abs(h0 - h1) - gap };
    }

    // Natural heights of the guides content, measured at runtime so font
    // scaling and theme tweaks don't break the layout math.
    function guidesMetrics(guides: HTMLElement) {
        const cards = guides.querySelector<HTMLElement>(
            ".channel-guides__cards",
        );
        const action = guides.querySelector<HTMLElement>(
            ".channel-guides__action",
        );
        const gap = parseFloat(getComputedStyle(guides).gap) || 0;
        // Compact split-bar natural height — the in-gap layout with the nav
        // cards stacked on the left (碎碎念 above 文章).
        guides.classList.add("is-compact");
        const barH = guides.offsetHeight;
        guides.classList.remove("is-compact");
        // Parked bar natural height — full-width below the grid with the
        // nav cards side by side. Used when the gap is too tight for the
        // split bar.
        guides.classList.add("is-compact", "is-parked");
        const parkedH = guides.offsetHeight;
        guides.classList.remove("is-compact", "is-parked");
        // Compressed chip natural height — the flat nav card used once the
        // gap is too small for the roomy stacked layout.
        guides.classList.add("is-tight");
        const chipH = cards?.firstElementChild
            ? (cards.firstElementChild as HTMLElement).offsetHeight
            : 0;
        guides.classList.remove("is-tight");
        // The action is flex: 0 0 auto, so its offsetHeight is the natural
        // height of whichever toggle (expand / collapse) is currently shown.
        const toggleH = action ? action.offsetHeight : 0;
        // Nav cards are never stretched (only their wrapping grid is), so the
        // natural height comes from the text lines + gap + padding + border.
        let cardsH = 0;
        const card = cards?.firstElementChild as HTMLElement | null;
        if (card) {
            const cs = getComputedStyle(card);
            const strong = card.querySelector("strong");
            const span = card.querySelector("span");
            cardsH =
                (strong?.offsetHeight ?? 0) +
                (span?.offsetHeight ?? 0) +
                (parseFloat(cs.gap) || 0) +
                parseFloat(cs.paddingTop) +
                parseFloat(cs.paddingBottom) +
                parseFloat(cs.borderTopWidth) +
                parseFloat(cs.borderBottomWidth);
        }
        return { cardsH, toggleH, barH, parkedH, chipH, gap };
    }

    function setGuidesHeight(guides: HTMLElement, px: number) {
        guides.style.height = `${px}px`;
        guides.style.minHeight = `${px}px`;
    }

    // Nav cards lay out horizontally by default in the compact bar; once
    // they are stretched tall enough to hold title + description stacked,
    // switch them to a vertical, centered layout instead.
    function syncEntryLayout(cards: HTMLElement | null) {
        if (!cards) return;
        const card = cards.firstElementChild as HTMLElement | null;
        if (!card) return;
        const strong = card.querySelector("strong");
        const span = card.querySelector("span");
        const cs = getComputedStyle(card);
        const pad =
            (parseFloat(cs.paddingTop) || 0) +
            (parseFloat(cs.paddingBottom) || 0);
        const gap = parseFloat(cs.gap) || 0;
        const need =
            (strong?.offsetHeight ?? 0) + (span?.offsetHeight ?? 0) + gap;
        cards.classList.toggle("is-vertical", card.clientHeight - pad >= need);
    }

    function syncChannelFill(root: HTMLElement) {
        if (!window.matchMedia(DESKTOP_MQ).matches) {
            hideGuides(root);
            return;
        }

        const guides = root.querySelector<HTMLElement>("[data-channel-guides]");
        if (!guides) return;

        parkGuides(root);
        guides.classList.remove(
            "is-compact",
            "is-parked",
            "is-tight",
            "is-stacked",
            "is-fill-left",
            "is-fill-right",
        );
        const fillCards = guides.querySelector<HTMLElement>(
            ".channel-guides__cards",
        );
        const fillAction = guides.querySelector<HTMLElement>(
            ".channel-guides__action",
        );
        if (fillCards) {
            fillCards.style.height = "";
            fillCards.classList.remove("is-vertical");
        }
        if (fillAction) fillAction.style.height = "";
        hideExpands(root);
        hideCollapse(root);

        const result = shortColOf(root);
        if (!result) return;

        const foot = result.shortCol.querySelector(".channel-col__foot");
        result.shortCol.insertBefore(guides, foot);
        guides.hidden = false;

        // Show the correct toggle first so its height is measurable.
        syncToggle(root);

        const { cardsH, toggleH, barH, parkedH, chipH, gap } =
            guidesMetrics(guides);
        const fullH = cardsH + gap + toggleH;
        const chipFullH = chipH + gap + toggleH;

        if (result.fill >= fullH) {
            // Enough room to stack: nav cards stretch to absorb the slack and
            // the toggle sits under them, balancing the columns (unchanged).
            setGuidesHeight(guides, result.fill);
            return;
        }

        // Roomier stack won't fit, but the compressed chips + toggle still
        // stack inside the gap: keep the stacked arrangement and let the nav
        // cards compress — flat chips, or vertical again once they are tall
        // enough (syncEntryLayout).
        if (result.fill >= chipFullH) {
            guides.classList.add("is-tight");
            setGuidesHeight(guides, result.fill);
            if (fillCards) syncEntryLayout(fillCards);
            return;
        }

        // Only when even chips can't stack does the bar split side-by-side.
        // When the gap is tall enough for the stacked nav-card pair it stays
        // inside the short column and fills the gap exactly (its top meets
        // the gap top, its bottom the taller column's): nav cards stacked on
        // the left, toggle stretched on the right. When the gap is too tight
        // for that pair — or the columns are already level — the bar parks
        // below the grid at its natural height as a full-width bar with the
        // nav cards side by side.
        guides.classList.add("is-compact");
        if (result.fill >= barH) {
            setGuidesHeight(guides, result.fill);
            if (fillCards) syncEntryLayout(fillCards);
        } else {
            guides.classList.add("is-parked");
            root.appendChild(guides);
            setGuidesHeight(guides, parkedH);
        }
    }

    function syncHomeChannels(root: HTMLElement) {
        if (root.dataset.loading) return;
        syncChannelFill(root);
    }

    function shouldRestoreExpand(root: HTMLElement) {
        return (
            isExpandedCached() &&
            !root.classList.contains("is-expanded") &&
            root.dataset.hasMore === "1" &&
            !root.dataset.loading &&
            window.matchMedia(DESKTOP_MQ).matches
        );
    }

    async function expandChannels(
        root: HTMLElement,
        btn: HTMLButtonElement,
        observeCards: () => void,
        animate = true,
    ) {
        if (root.classList.contains("is-expanded") || root.dataset.loading)
            return;

        root.dataset.loading = "1";
        btn.disabled = true;
        if (!btn.dataset.label) btn.dataset.label = btn.textContent || "展开";
        const prev = btn.dataset.label;
        btn.textContent = "加载中…";

        try {
            const res = await fetch(MORE_URL, { credentials: "same-origin" });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const doc = new DOMParser().parseFromString(
                await res.text(),
                "text/html",
            );

            fillSlot(
                root.querySelector(
                    '[data-channel="thoughts"] [data-channel-more]',
                ),
                doc.querySelector("[data-more-thoughts]"),
                animate,
            );
            fillSlot(
                root.querySelector(
                    '[data-channel="blogs"] [data-channel-more]',
                ),
                doc.querySelector("[data-more-blogs]"),
                animate,
            );

            root.classList.add("is-expanded");
            setExpandedCached(true);
            observeCards();
            document.dispatchEvent(new Event("home:content"));
            syncChannelFill(root);
        } catch {
            btn.textContent = prev;
            btn.disabled = false;
            syncChannelFill(root);
        } finally {
            delete root.dataset.loading;
        }
    }

    function collapseChannels(root: HTMLElement) {
        if (!root.classList.contains("is-expanded") || root.dataset.loading)
            return;

        root.dataset.loading = "1";
        setExpandedCached(false);

        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const slots = [
            ...root.querySelectorAll<HTMLElement>("[data-channel-more]"),
        ];
        const cards = slots.flatMap((slot) => [
            ...slot.children,
        ]) as HTMLElement[];

        const teardown = () => {
            slots.forEach((slot) => slot.replaceChildren());
            root.classList.remove("is-expanded");
            delete root.dataset.loading;
            syncChannelFill(root);
        };

        // Scroll back to the top while the extra cards stay in layout, so
        // the document height stays stable (no clamped jump).
        if (window.scrollY > 1) {
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        }

        if (reduce || cards.length === 0) {
            teardown();
            return;
        }

        // Cards fade out together (no stagger) in parallel with the scroll.
        cards.forEach((card) => {
            card.classList.add("card-exit");
        });

        // Once the cards have faded, collapse the columns and fade the
        // height-fill area in — it is in place by then, so the fade is
        // actually visible.
        const guides = root.querySelector<HTMLElement>("[data-channel-guides]");
        window.setTimeout(() => {
            teardown();
            if (guides) {
                guides.animate([{ opacity: 0 }, { opacity: 1 }], {
                    duration: EXIT_MS,
                    easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                });
            }
        }, EXIT_MS + GUIDE_DELAY);
    }

    const observeByRoot = new WeakMap<HTMLElement, () => void>();

    function tryRestoreExpand(root: HTMLElement) {
        const observeCards = observeByRoot.get(root) ?? (() => {});
        if (!shouldRestoreExpand(root)) {
            syncHomeChannels(root);
            return;
        }
        const btn = root.querySelector<HTMLButtonElement>(
            "[data-channel-expand]",
        );
        if (!btn) {
            syncHomeChannels(root);
            return;
        }
        // Restored state (cached in localStorage) appears instantly — no
        // entrance animation.
        void expandChannels(root, btn, observeCards, false);
    }

    function initHomeChannels() {
        const root = document.querySelector<HTMLElement>(
            "[data-home-channels]",
        );
        if (!root) return;

        if (!root.dataset.expandBound) {
            root.dataset.expandBound = "1";

            const ro = new ResizeObserver(() => syncHomeChannels(root));
            const observeCards = () => {
                root.querySelectorAll<HTMLElement>(
                    "[data-channel] > .channel, [data-channel-more] > .channel",
                ).forEach((el) => ro.observe(el));
            };
            observeByRoot.set(root, observeCards);
            observeCards();

            root.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                const collapse = target.closest(
                    "[data-channel-collapse]",
                ) as HTMLButtonElement | null;
                if (collapse && root.contains(collapse)) {
                    void collapseChannels(root);
                    return;
                }
                const btn = target.closest(
                    "[data-channel-expand]",
                ) as HTMLButtonElement | null;
                if (!btn || !root.contains(btn)) return;
                void expandChannels(root, btn, observeCards);
            });

            window.matchMedia(DESKTOP_MQ).addEventListener("change", () => {
                tryRestoreExpand(root);
            });
            window.addEventListener("load", () => tryRestoreExpand(root), {
                once: true,
            });
        }

        tryRestoreExpand(root);
    }

    initHomeChannels();
    if (!window.__homeChannelsInit) {
        window.__homeChannelsInit = true;
        document.addEventListener("astro:page-load", initHomeChannels);
    }
</script>
